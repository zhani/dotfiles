#!/usr/bin/env bash
#
# Cross-platform dotfiles installer (macOS + Ubuntu).
# Run from the repo root:  ./setup
#
# Detects the OS and installs the terminal stack (alacritty, tmux, neovim,
# fonts, language tooling) via Homebrew on macOS or apt on Ubuntu, then stows
# the configs. The stow/tmux/bashrc steps are shared across both platforms.

set -u

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DOTFILES_DIR" || exit 1

case "$(uname -s)" in
  Darwin) OS="macos" ;;
  Linux)  OS="ubuntu" ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac
echo "==> Detected OS: $OS"

# --------------------------------------------------------------------------
# Clean state (paths are valid on both platforms)
# --------------------------------------------------------------------------
rm -rf ~/.local/bin
rm -rf ~/.config/alacritty
rm -rf ~/.config/nvim
rm -rf ~/.config/tmux
rm -rf ~/.local/state/nvim
rm -rf ~/.cache/nvim
rm -rf ~/.tmux
rm -rf ~/.bashrc.d

# Create real directories *before* stowing so stow never folds ~/.local/share
# (or its parents) into a single symlink pointing back into this repo.
mkdir -p ~/.local/bin ~/.local/share ~/.config

# --------------------------------------------------------------------------
# Package installation
# --------------------------------------------------------------------------
install_macos() {
  # Bootstrap Homebrew if missing.
  if ! command -v brew >/dev/null 2>&1; then
    echo "==> Installing Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi

  echo "==> Installing Homebrew formulae"
  brew install \
    git stow tmux \
    fzf ripgrep fd luarocks tree-sitter \
    python node go ruby rust ruff \
    llvm bear cmake \
    openjdk@21 kotlin

  # neovim and lazygit are installed by their own scripts (cross-platform):
  #   ./scripts/install-neovim
  #   ./scripts/install-lazygit

  echo "==> Installing Alacritty (cask)"
  brew install --cask alacritty || true

  # pylatexenc has no brew formula; install for nvim's LaTeX rendering if pip exists.
  python3 -m pip install --user --quiet pylatexenc 2>/dev/null || \
    echo "    (skipped pylatexenc; install manually if you need LaTeX preview)"

  # NOTE: Caps Lock -> Esc is mapped manually via
  # System Settings -> Keyboard -> Keyboard Shortcuts -> Modifier Keys.
}

install_ubuntu() {
  sudo apt update
  sudo apt install -y git stow curl unzip
  sudo apt install -y gnome-tweaks # To map Caps to Esc

  # For Python-based LSPs
  sudo apt install -y python3 python3-pip
  # For Javascript-based LSPs
  sudo apt install -y nodejs npm
  # For Go-based LSPs
  sudo apt install -y golang-go
  # For Ruby-based Tools
  sudo apt install -y ruby
  # For Rust LSPs
  sudo apt install -y rustc ruff python3-ruff
  # For C/C++ LSPs and formatters
  sudo apt install -y bear cmake clang clangd
  # For Kotlin LSPs
  sudo apt install -y openjdk-21-jdk openjdk-21-jre kotlin
  # For neovim
  sudo apt install -y fd-find fzf luarocks python3-pylatexenc ripgrep tree-sitter-cli
  # Debian ships fd as `fdfind`; expose it under the expected name.
  [ -e ~/.local/bin/fd ] || ln -s "$(which fdfind)" ~/.local/bin/fd

  # neovim and lazygit are installed by their own scripts (cross-platform):
  #   ./scripts/install-neovim   (builds neovim v0.12.3 from source)
  #   ./scripts/install-lazygit

  sudo apt install -y alacritty
  sudo apt install -y tmux
}

# --------------------------------------------------------------------------
# Fonts
# --------------------------------------------------------------------------
install_fonts_macos() {
  # Hand-placing fonts in ~/Library/Fonts doesn't reliably register with Core
  # Text; the Homebrew cask installs and registers the Nerd Font correctly,
  # which is all Alacritty needs on mac.
  echo "==> Installing Ubuntu Mono Nerd Font (cask)"
  brew install --cask font-ubuntu-mono-nerd-font
}

install_fonts_ubuntu() {
  echo "==> Installing fonts via stow + fc-cache"
  stow fonts
  fc-cache -fv
}

# --------------------------------------------------------------------------
# Shell: make brew bash (5.x) the login shell on macOS
# --------------------------------------------------------------------------
setup_shell_macos() {
  local brew_bash="/opt/homebrew/bin/bash"
  [ -x "$brew_bash" ] || brew_bash="$(brew --prefix 2>/dev/null)/bin/bash"
  if [ -x "$brew_bash" ]; then
    if ! grep -qx "$brew_bash" /etc/shells; then
      echo "==> Adding $brew_bash to /etc/shells"
      echo "$brew_bash" | sudo tee -a /etc/shells >/dev/null
    fi
    if [ "$SHELL" != "$brew_bash" ]; then
      echo "==> Setting login shell to $brew_bash"
      chsh -s "$brew_bash" || echo "    (chsh failed; run it manually)"
    fi
  fi

  # Login shells on macOS read ~/.bash_profile, not ~/.bashrc. Make sure it
  # sources ~/.bashrc so the ~/.bashrc.d setup below takes effect.
  local bp="$HOME/.bash_profile"
  if ! grep -qs 'bashrc' "$bp" 2>/dev/null; then
    echo "==> Linking ~/.bash_profile -> ~/.bashrc"
    printf '\n[ -r ~/.bashrc ] && . ~/.bashrc\n' >>"$bp"
  fi
}

# --------------------------------------------------------------------------
# Shared: source ~/.bashrc.d
# --------------------------------------------------------------------------
ensure_bashrc_d() {
  BASHRC="$HOME/.bashrc"
  BASHRC_D_DIR="$HOME/.bashrc.d"
  touch "$BASHRC"

  BASHRC_D_BLOCK=$(
    cat <<'EOF'
# Source all scripts in ~/.bashrc.d
if [ -d "$HOME/.bashrc.d" ]; then
    for file in "$HOME/.bashrc.d"/*; do
        [ -r "$file" ] && [ -f "$file" ] && . "$file"
    done
    unset file
fi
EOF
  )

  if ! grep -Fxq "# Source all scripts in ~/.bashrc.d" "$BASHRC"; then
    echo "Appending .bashrc.d sourcing block to $BASHRC..."
    echo -e "\n$BASHRC_D_BLOCK" >>"$BASHRC"
  else
    echo "Sourcing block already exists in $BASHRC. No changes made."
  fi

  if [ ! -d "$BASHRC_D_DIR" ]; then
    mkdir -p "$BASHRC_D_DIR"
    chmod 700 "$BASHRC_D_DIR"
  fi
}

# --------------------------------------------------------------------------
# Run
# --------------------------------------------------------------------------
if [ "$OS" = "macos" ]; then
  install_macos
  install_fonts_macos
else
  install_ubuntu
  install_fonts_ubuntu
fi

# Install tmux plugin manager
rm -rf ~/.tmux/plugins/tpm
git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm

# Stow the shared config packages
stow alacritty tmux nvim

# Shell setup (macOS-specific)
if [ "$OS" = "macos" ]; then
  setup_shell_macos
fi

# Set up ~/.bashrc.d sourcing and stow the bash config
echo "Ensuring .bashrc.d sourcing is set up..."
ensure_bashrc_d
stow bashrc

echo "==> Done. Restart your terminal (or run: exec bash -l)"

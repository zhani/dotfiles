# Install .bashrc
ensure_bashrc_d() {
  BASHRC="$HOME/.bashrc"
  BASHRC_D_DIR="$HOME/.bashrc.d"

  # Define the sourcing block
  BASHRC_D_BLOCK=$(
    cat <<'EOF'
# Source all scripts in ~/.bashrc.d
if [ -d "$HOME/.bashrc.d" ]; then
    for file in "$HOME/.bashrc.d"/*; do
        [ -r "$file" ] && [ -f "$file" ] && . "$file"
    done
    unset file
fi
EOF
  )

  # Check if the block already exists in .bashrc
  if ! grep -Fxq "# Source all scripts in ~/.bashrc.d" "$BASHRC"; then
    echo "Appending .bashrc.d sourcing block to $BASHRC..."
    echo -e "\n$BASHRC_D_BLOCK" >>"$BASHRC"
    echo "Successfully added .bashrc.d sourcing block."
  else
    echo "Sourcing block already exists in $BASHRC. No changes made."
  fi

  # Ensure ~/.bashrc.d directory exists
  if [ ! -d "$BASHRC_D_DIR" ]; then
    echo "Creating ~/.bashrc.d directory..."
    mkdir -p "$BASHRC_D_DIR"
    chmod 700 "$BASHRC_D_DIR"
    echo "Directory ~/.bashrc.d created."
  else
    echo "Directory ~/.bashrc.d already exists."
  fi
}

# Call the function within your setup script
echo "Ensuring .bashrc.d sourcing is set up..."
ensure_bashrc_d
stow bashrc

echo "Restarting bash session"
exec bash
